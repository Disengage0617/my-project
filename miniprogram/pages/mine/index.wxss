@import "../../app.wxss";

.mine-page {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.brand-row,
.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-row {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  color: #22f5ff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  text-shadow: 4rpx 0 0 rgba(223, 75, 255, 0.72), 0 0 24rpx rgba(34, 245, 255, 0.72);
}

.brand-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-sub {
  margin-top: 6rpx;
  color: #dfe6ff;
  font-size: 20rpx;
  font-weight: 700;
}

.member-hero {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  border: 1rpx solid rgba(73, 238, 255, 0.25);
  border-radius: 24rpx;
  background: #050913;
}

.member-bg,
.member-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.member-bg {
  display: block;
}

.member-mask {
  background:
    linear-gradient(90deg, rgba(3, 5, 11, 0.96) 0%, rgba(3, 5, 11, 0.82) 52%, rgba(3, 5, 11, 0.46) 100%),
    radial-gradient(circle at 78% 18%, rgba(224, 68, 255, 0.34), transparent 34%);
}

.member-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 26rpx 26rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  overflow: hidden;
  border: 3rpx solid rgba(224, 68, 255, 0.72);
  border-radius: 50%;
  box-shadow: 0 0 28rpx rgba(224, 68, 255, 0.32);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-id,
.profile-desc {
  margin-top: 8rpx;
  color: #aeb6d7;
  font-size: 22rpx;
  font-weight: 700;
}

.vip-badge {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(224, 68, 255, 0.88), rgba(110, 92, 255, 0.80));
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.member-grade {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 36rpx;
}

.grade-label {
  color: #9da7c4;
  font-size: 22rpx;
  font-weight: 700;
}

.grade-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
}

.growth-box {
  text-align: right;
}

.growth-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
}

.progress-track {
  height: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(149, 164, 207, 0.14);
}

.progress-fill {
  width: 56%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #22f5ff, #e044ff);
  box-shadow: 0 0 20rpx rgba(34, 245, 255, 0.50);
}

.asset-panel {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1rpx solid rgba(73, 238, 255, 0.46);
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(34, 245, 255, 0.20), transparent 34%),
    radial-gradient(circle at 100% 0%, rgba(224, 68, 255, 0.18), transparent 38%),
    linear-gradient(180deg, rgba(11, 20, 33, 0.96), rgba(5, 10, 18, 0.98));
  box-shadow: inset 0 0 36rpx rgba(34, 245, 255, 0.06), 0 0 26rpx rgba(34, 245, 255, 0.10);
  overflow: hidden;
}

.asset-item {
  min-height: 170rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid rgba(149, 164, 207, 0.24);
}

.asset-item:active {
  background: rgba(255, 255, 255, 0.04);
  transform: scale(0.98);
}

.asset-item:first-child {
  border-left: 0;
}

.asset-icon {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.cyan-icon {
  color: #8bf8ff;
  text-shadow: 0 0 18rpx rgba(34, 245, 255, 0.62);
}

.violet-icon {
  color: #c99aff;
  text-shadow: 0 0 18rpx rgba(224, 68, 255, 0.58);
}

.asset-value {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.22);
}

.asset-label {
  margin-top: 16rpx;
  color: #f5f8ff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.cyber-heading {
  margin-bottom: 16rpx;
}

.reservation-card {
  display: flex;
  align-items: center;
  min-height: 144rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.18);
  border-radius: 20rpx;
  background: linear-gradient(90deg, rgba(9, 16, 29, 0.96), rgba(5, 10, 18, 0.98));
  box-sizing: border-box;
}

.reservation-thumb {
  width: 132rpx;
  height: 102rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #050913;
}

.reservation-info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.confirmed-tag {
  display: inline-flex;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.38);
  border-radius: 999rpx;
  color: #22f5ff;
  font-size: 18rpx;
  font-weight: 900;
}

.reservation-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.reservation-time,
.reservation-meta {
  margin-top: 8rpx;
  color: #aeb6d7;
  font-size: 21rpx;
  font-weight: 700;
}

.verify-btn {
  flex-shrink: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.72);
  border-radius: 14rpx;
  background: rgba(224, 68, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 0 24rpx rgba(224, 68, 255, 0.24);
}

.feature-panel {
  padding: 24rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.26);
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 8% 18%, rgba(34, 245, 255, 0.12), transparent 32%),
    radial-gradient(circle at 86% 18%, rgba(224, 68, 255, 0.12), transparent 36%),
    linear-gradient(180deg, rgba(8, 18, 30, 0.96), rgba(4, 9, 17, 0.98));
  box-shadow: inset 0 0 40rpx rgba(34, 245, 255, 0.05);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx 14rpx;
}

.feature-item {
  min-width: 0;
  min-height: 174rpx;
  padding: 20rpx 8rpx 18rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.32);
  border-radius: 16rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(34, 245, 255, 0.16), transparent 44%),
    linear-gradient(180deg, rgba(16, 29, 45, 0.92), rgba(7, 12, 25, 0.98));
  text-align: center;
  box-sizing: border-box;
  box-shadow: inset 0 0 24rpx rgba(34, 245, 255, 0.06);
}

.feature-violet {
  border-color: rgba(197, 129, 255, 0.42);
  background:
    radial-gradient(circle at 50% 18%, rgba(224, 68, 255, 0.18), transparent 44%),
    linear-gradient(180deg, rgba(22, 22, 46, 0.94), rgba(8, 10, 25, 0.98));
}

.feature-icon {
  color: #8bf8ff;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(34, 245, 255, 0.52);
}

.feature-violet .feature-icon {
  color: #c99aff;
  text-shadow: 0 0 20rpx rgba(224, 68, 255, 0.52);
}

.feature-title {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.08;
  white-space: nowrap;
}

.feature-desc {
  margin-top: 12rpx;
  color: #9da7c4;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.auth-button {
  width: 100%;
  height: 76rpx;
  margin: 0 0 20rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.28);
  border-radius: 18rpx;
  background: rgba(34, 245, 255, 0.08);
  color: #dfe6ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 76rpx;
}
