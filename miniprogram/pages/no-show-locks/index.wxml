<view class="page">
  <view class="page-header">
    <view class="eyebrow">爽约限制</view>
    <view class="title large">限制记录和解除</view>
    <view class="subtitle">员工标记未到后限制 3 天，店长解除时必须记录原因。</view>
  </view>

  <view wx:if="{{loading}}" class="panel section">
    <view class="subtitle">正在加载限制记录...</view>
  </view>
  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="stack">
    <block wx:for="{{locks}}" wx:key="id">
      <view class="panel">
        <view class="row start">
          <view>
            <view class="title">{{item.userName}}</view>
            <view class="subtitle">{{item.reason}} · {{item.lockUntilText}}</view>
          </view>
          <view class="tag {{item.status === '已解除' ? 'muted' : 'danger'}}">{{item.status}}</view>
        </view>
        <view class="divider"></view>
        <view class="row">
          <view class="subtitle">关联预约：{{item.reservationId}}</view>
          <view class="tag {{item.status === '已解除' ? 'muted' : ''}}" data-id="{{item.id}}" bindtap="lift">{{actioningId === item.id ? '解除中' : '解除'}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && !locks.length}}" class="panel empty">
    <view class="title">暂无限制记录</view>
    <view class="subtitle">标记未到后，限制记录会出现在这里。</view>
  </view>
</view>
