<view class="page">
  <view class="page-header">
    <view class="eyebrow">MINE</view>
    <view class="title large">{{title}}</view>
    <view class="subtitle">这里仅展示可查看记录，支付、核销和充值会在后续阶段接入。</view>
  </view>

  <view wx:if="{{loading}}" class="panel section">
    <view class="subtitle">正在加载...</view>
  </view>

  <view class="stack">
    <block wx:for="{{items}}" wx:key="title">
      <view class="panel">
        <view class="row start">
          <view class="feature-copy">
            <view class="title">{{item.title}}</view>
            <view class="subtitle">{{item.desc}}</view>
          </view>
          <view class="tag">{{item.tag}}</view>
        </view>
        <view wx:if="{{item.value}}" class="divider"></view>
        <view wx:if="{{item.value}}" class="tag gold">{{item.value}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && !items.length}}" class="panel empty">
    <view class="title">暂无内容</view>
    <view class="subtitle">{{emptyText}}</view>
  </view>
</view>
