<view class="page reservation-page safe-bottom">
  <view class="brand-row">
    <view class="brand-lockup">
      <view class="brand-mark">W</view>
      <view>
        <view class="brand-name">W POOL</view>
        <view class="brand-sub">台球俱乐部</view>
      </view>
    </view>
    <view class="store-pill">昆明路店 ›</view>
  </view>

  <view class="reservation-hero section">
    <image class="hero-bg" src="/assets/generated/home-cyber-hero-table.png" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-content">
      <view class="hero-title">预约桌台</view>
      <view class="hero-slogan">精准选桌 · 到店即打</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">选择日期</view>
    <scroll-view scroll-x class="date-strip">
      <block wx:for="{{dateOptions}}" wx:key="value">
        <view class="date-chip {{selectedDate === item.value ? 'active-chip' : ''}}" data-value="{{item.value}}" bindtap="selectDate">
          <view>{{item.label}}</view>
          <text>{{item.dateText}}</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="booking-card section">
    <view class="control-row">
      <view class="control-title">时长</view>
      <view class="stepper-row">
        <view class="step-btn" data-delta="-1" bindtap="changeDuration">-</view>
        <view class="step-value">{{durationHours}}小时</view>
        <view class="step-btn" data-delta="1" bindtap="changeDuration">+</view>
      </view>
    </view>
    <view class="control-row">
      <view class="control-title">人数</view>
      <view class="stepper-row">
        <view class="step-btn" data-delta="-1" bindtap="changePeople">-</view>
        <view class="step-value">{{peopleCount}}人</view>
        <view class="step-btn" data-delta="1" bindtap="changePeople">+</view>
      </view>
    </view>
    <view class="time-panel">
      <view class="time-panel-head">
        <view>
          <view class="control-title">预计到店时间</view>
          <view class="panel-desc">上下滑动选择预计到店时间，5 分钟一个可约时刻。</view>
        </view>
        <view class="arrival-value">{{startTime}}</view>
      </view>
      <picker-view
        class="time-wheel"
        value="{{timePickerValue}}"
        bindpickstart="startTimePicking"
        bindchange="changeTimePicker"
        bindpickend="endTimePicking"
        indicator-class="time-wheel-indicator"
        mask-class="time-wheel-mask"
      >
        <picker-view-column>
          <block wx:for="{{timePickerHours}}" wx:key="*this">
            <view class="time-wheel-item">{{item}}</view>
          </block>
        </picker-view-column>
        <picker-view-column>
          <block wx:for="{{timePickerMinutes}}" wx:key="*this">
            <view class="time-wheel-item">{{item}}</view>
          </block>
        </picker-view-column>
      </picker-view>
      <view class="time-wheel-labels">
        <view>小时</view>
        <view>分钟</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section panel">
    <view class="subtitle">正在加载可预约资源...</view>
  </view>
  <view wx:if="{{errorMessage}}" class="section panel">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="section">
    <view class="section-title">选择桌台 <text>{{availabilityMessage}}</text></view>
    <scroll-view scroll-x class="filter-strip">
      <block wx:for="{{tableTypeOptions}}" wx:key="key">
        <view class="filter-chip {{selectedTableType === item.key ? 'active-chip' : ''}}" data-key="{{item.key}}" bindtap="selectTableType">{{item.name}}</view>
      </block>
    </scroll-view>
    <view class="table-grid">
      <block wx:for="{{tables}}" wx:key="id">
        <view class="table-card {{item.cardClass}} {{selectedTableId === item.id ? 'selected-card' : ''}}" data-id="{{item.id}}" bindtap="selectTable">
          <image class="table-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="table-badge" wx:if="{{index === 0}}">TOP</view>
          <view class="table-info">
            <view class="table-code">{{item.code}}</view>
            <view class="table-type">{{item.type}}</view>
            <view class="table-meta">剩余 {{durationHours}} 小时</view>
            <view class="table-tags">
              <text>{{peopleCount}}-6人</text>
              <text>{{item.seatText}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="assistant-strip section">
    <view class="section-title">助理教练 <text>可不选</text></view>
    <scroll-view scroll-x>
      <block wx:for="{{assistants}}" wx:key="id">
        <view class="assistant-chip {{selectedAssistantId === item.id ? 'selected-assistant' : ''}}" data-id="{{item.id}}" bindtap="selectAssistant">
          <image class="assistant-avatar" src="{{item.photoUrl}}" mode="aspectFill" />
          <view>
            <view class="assistant-name">{{item.name}}</view>
            <view class="assistant-price">¥{{item.price}}/小时</view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="fixed-submit">
    <view class="submit-meta">{{selectedDate}} {{startTime}}-{{endTimeText}} · {{estimatedAmountText}}</view>
    <view class="submit-button {{canSubmit ? '' : 'disabled'}}" bindtap="submitReservation">
      <text>{{submitting ? '提交中...' : '立即预约'}}</text>
      <view class="submit-arrow">›</view>
    </view>
  </view>
</view>
