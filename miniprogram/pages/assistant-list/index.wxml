<view class="page assistant-page">
  <view class="brand-row">
    <view class="brand-lockup">
      <view class="brand-mark">W</view>
      <view>
        <view class="brand-name">W POOL</view>
        <view class="brand-sub">台球俱乐部</view>
      </view>
    </view>
    <view class="store-pill">昆明路店 ›</view>
  </view>

  <view class="coach-hero section">
    <image class="coach-bg" src="/assets/generated/billiards-bg-option-5-coach.png" mode="aspectFill" />
    <view class="coach-mask"></view>
    <view class="coach-copy">
      <view class="coach-title">专业助教</view>
      <view class="coach-subtitle">一对一指导 · 快速提升</view>
    </view>
  </view>

  <view class="coach-tabs section">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="coach-tab {{activeTab === item.key ? 'active-tab' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchCoachTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="panel section">
    <view class="subtitle">正在加载助教...</view>
  </view>
  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="coach-list">
    <block wx:for="{{filteredAssistants}}" wx:key="id">
      <view class="coach-card" data-id="{{item.id}}" bindtap="goBooking">
        <view class="rank-badge rank-{{index + 1}}">{{index + 1}}</view>
        <image class="coach-photo" src="{{item.photoUrl}}" mode="aspectFill" />
        <view class="coach-info">
          <view class="coach-name-row">
            <view class="coach-name">{{item.name}}</view>
            <view class="coach-level">{{item.level}}</view>
          </view>
          <view class="coach-skill">擅长：{{item.tagsText}}</view>
          <view class="coach-rating">★ {{item.rating}} <text>{{item.bookingText}}</text></view>
        </view>
        <view class="coach-side">
          <view class="coach-price">¥{{item.price}}<text>/小时</text></view>
          <view class="reserve-btn">预约</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && !filteredAssistants.length}}" class="panel empty">
    <view class="title">暂无匹配助教</view>
    <view class="subtitle">可切换其他筛选项，或到店后咨询员工安排。</view>
  </view>

  <view class="more-coach">更多教练，点击查看⌄</view>
</view>
