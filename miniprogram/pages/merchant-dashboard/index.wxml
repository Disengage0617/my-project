<view class="page">
  <view class="page-header">
    <view class="eyebrow">商家后台</view>
    <view class="title large">门店运营总览</view>
    <view class="subtitle">先保证预约、桌台、价格和助教基础配置可用。</view>
  </view>

  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="grid section">
    <view class="hero">
      <view class="subtitle">当前空桌</view>
      <view class="metric light">{{overview.freeTableCount || 0}}</view>
      <view class="subtitle">共 {{overview.store.tableCount || 0}} 张</view>
    </view>
    <view class="panel">
      <view class="tag gold">助教</view>
      <view class="metric">{{overview.freeAssistantCount || 0}}</view>
      <view class="subtitle">当前空闲</view>
    </view>
  </view>

  <view class="panel section">
    <view class="title">配置完整度</view>
    <block wx:for="{{entries}}" wx:key="name">
      <view class="divider"></view>
      <view class="row">
        <view>{{item.name}}</view>
        <view class="tag {{item.status === '已完成' ? '' : 'gold'}}">{{item.status}}</view>
      </view>
    </block>
  </view>

  <view class="panel flat">
    <view class="title">下一步运营能力</view>
    <view class="subtitle">商家配置、客户列表、报名名单和爽约限制已进入接口联调，可继续在配置中心逐项检查。</view>
  </view>
</view>
