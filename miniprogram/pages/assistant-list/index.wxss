@import "../../app.wxss";

.assistant-page {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.brand-row,
.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-row {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  color: #22f5ff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  text-shadow: 4rpx 0 0 rgba(223, 75, 255, 0.72), 0 0 24rpx rgba(34, 245, 255, 0.72);
}

.brand-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-sub {
  margin-top: 6rpx;
  color: #dfe6ff;
  font-size: 20rpx;
  font-weight: 700;
}

.store-pill {
  padding: 14rpx 24rpx;
  border: 1rpx solid rgba(211, 217, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(3, 7, 14, 0.72);
  color: #f7f8ff;
  font-size: 23rpx;
  font-weight: 800;
}

.coach-hero {
  position: relative;
  height: 268rpx;
  overflow: hidden;
  border: 1rpx solid rgba(73, 238, 255, 0.25);
  border-radius: 24rpx;
  background: #050913;
}

.coach-bg,
.coach-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.coach-bg {
  display: block;
}

.coach-mask {
  background:
    linear-gradient(90deg, rgba(3, 5, 11, 0.78) 0%, rgba(3, 5, 11, 0.36) 60%, rgba(3, 5, 11, 0.10) 100%),
    radial-gradient(circle at 30% 62%, rgba(34, 245, 255, 0.18), transparent 42%),
    radial-gradient(circle at 78% 22%, rgba(224, 68, 255, 0.22), transparent 34%);
}

.coach-copy {
  position: relative;
  z-index: 2;
  padding: 78rpx 32rpx 0;
}

.coach-title {
  color: #f7fbff;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 22rpx rgba(34, 245, 255, 0.50), 6rpx 0 0 rgba(224, 68, 255, 0.34);
}

.coach-subtitle {
  margin-top: 18rpx;
  color: #f1f5ff;
  font-size: 25rpx;
  font-weight: 900;
}

.coach-tabs {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.16);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(13, 20, 32, 0.96), rgba(5, 10, 18, 0.98));
}

.coach-tab {
  flex: 1;
  position: relative;
  min-height: 72rpx;
  color: #9da7c4;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.active-tab {
  color: #ffffff;
}

.active-tab::after {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: -20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #22f5ff, #e044ff);
  box-shadow: 0 0 16rpx rgba(224, 68, 255, 0.60);
}

.coach-tab:active,
.coach-card:active,
.reserve-btn:active {
  transform: scale(0.98);
}

.coach-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.coach-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 156rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.18);
  border-radius: 22rpx;
  background: linear-gradient(90deg, rgba(13, 20, 32, 0.96), rgba(5, 10, 18, 0.98));
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.38);
  box-sizing: border-box;
}

.rank-badge {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #aeb6d7, #4b556f);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
}

.rank-1 {
  background: linear-gradient(135deg, #ffd470, #a86525);
}

.rank-2 {
  background: linear-gradient(135deg, #dfe6ff, #6f7790);
}

.rank-3 {
  background: linear-gradient(135deg, #e4a562, #8d5634);
}

.coach-photo {
  width: 118rpx;
  height: 118rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #050913;
}

.coach-info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.coach-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.coach-name {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.coach-level {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(224, 68, 255, 0.22);
  color: #d9b6ff;
  font-size: 17rpx;
  font-weight: 900;
}

.coach-skill {
  margin-top: 12rpx;
  color: #aeb6d7;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.coach-rating {
  margin-top: 12rpx;
  color: #ffd470;
  font-size: 22rpx;
  font-weight: 900;
}

.coach-rating text {
  margin-left: 14rpx;
  color: #9da7c4;
  font-weight: 700;
}

.coach-side {
  width: 132rpx;
  flex-shrink: 0;
  text-align: right;
}

.coach-price {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.coach-price text {
  color: #aeb6d7;
  font-size: 18rpx;
  font-weight: 700;
}

.reserve-btn {
  height: 58rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.72);
  border-radius: 14rpx;
  background: rgba(224, 68, 255, 0.18);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
  box-shadow: 0 0 24rpx rgba(224, 68, 255, 0.28);
}

.more-coach {
  margin-top: 24rpx;
  color: #aeb6d7;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}
