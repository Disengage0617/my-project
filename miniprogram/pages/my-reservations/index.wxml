<view class="page">
  <view class="page-header">
    <view class="eyebrow">我的预约</view>
    <view class="title large">到店前后都看得清</view>
    <view class="subtitle">待到店可提交核实，核实后由员工开台，完成后保留记录。</view>
  </view>

  <scroll-view scroll-x class="reservation-tabs">
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="reservation-tab {{activeTab === item.key ? 'active-tab' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </block>
  </scroll-view>

  <view wx:if="{{loading}}" class="panel section">
    <view class="subtitle">正在加载预约记录...</view>
  </view>
  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="stack">
    <block wx:for="{{reservations}}" wx:key="id">
      <view class="panel">
        <view class="row start">
          <view>
            <view class="title">{{item.tableTitle}}</view>
            <view class="subtitle">{{item.startTime}}-{{item.endTime}} · {{item.assistantText}}</view>
          </view>
          <view class="tag">{{item.statusText}}</view>
        </view>
        <view class="divider"></view>
        <view class="row">
          <view class="subtitle">{{item.statusDesc}}</view>
          <view class="tag muted">{{item.reservationCode}}</view>
        </view>
        <view class="row section">
          <view class="tag gold">{{item.amountText}}</view>
          <view class="row reservation-actions">
            <view class="tag muted" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
            <view wx:if="{{item.canSubmitArrival}}" class="tag" data-id="{{item.id}}" bindtap="submitArrival">
              {{actioningId === item.id ? '提交中' : item.primaryActionText}}
            </view>
            <view wx:else class="tag muted">{{item.primaryActionText}}</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loading && !reservations.length}}" class="panel empty">
    <view class="title">暂无预约</view>
    <view class="subtitle">当前筛选下没有预约记录。</view>
  </view>
</view>
