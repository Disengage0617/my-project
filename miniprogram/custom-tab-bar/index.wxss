.custom-tabbar {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 4rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 124rpx;
  padding: 8rpx 10rpx 6rpx;
  border: 1rpx solid rgba(117, 136, 178, 0.34);
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 20% 0%, rgba(34, 245, 255, 0.14), transparent 28%),
    radial-gradient(circle at 50% 0%, rgba(224, 68, 255, 0.12), transparent 30%),
    linear-gradient(180deg, rgba(8, 15, 29, 0.98), rgba(3, 7, 14, 0.98));
  box-shadow: 0 -18rpx 54rpx rgba(0, 0, 0, 0.42), inset 0 0 34rpx rgba(34, 245, 255, 0.05);
  box-sizing: border-box;
}

.tabbar-item {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.tabbar-label {
  margin-top: 6rpx;
  color: #8b8fa8;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.tabbar-item.active .tabbar-icon {
  width: 64rpx;
  height: 64rpx;
  filter: drop-shadow(0 0 12rpx rgba(34, 245, 255, 0.75));
}

.tabbar-item.active .tabbar-label {
  color: #22f5ff;
  text-shadow: 0 0 16rpx rgba(34, 245, 255, 0.62), 4rpx 0 16rpx rgba(224, 68, 255, 0.46);
}
