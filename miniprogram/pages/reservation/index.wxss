@import "../../app.wxss";

.reservation-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  color: #22f5ff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  text-shadow: 4rpx 0 0 rgba(223, 75, 255, 0.72), 0 0 24rpx rgba(34, 245, 255, 0.72);
}

.brand-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-sub {
  margin-top: 6rpx;
  color: #dfe6ff;
  font-size: 20rpx;
  font-weight: 700;
}

.store-pill {
  max-width: 220rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid rgba(211, 217, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(3, 7, 14, 0.72);
  color: #f7f8ff;
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
  box-sizing: border-box;
}

.reservation-hero {
  position: relative;
  height: 258rpx;
  overflow: hidden;
  border: 1rpx solid rgba(73, 238, 255, 0.28);
  border-radius: 24rpx;
  background: #050913;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.hero-bg,
.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-bg {
  display: block;
}

.hero-mask {
  background:
    linear-gradient(90deg, rgba(2, 5, 10, 0.74) 0%, rgba(2, 5, 10, 0.36) 58%, rgba(2, 5, 10, 0.12) 100%),
    radial-gradient(circle at 20% 70%, rgba(34, 245, 255, 0.18), transparent 42%),
    radial-gradient(circle at 74% 22%, rgba(224, 68, 255, 0.20), transparent 38%);
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 74rpx 34rpx 0;
}

.hero-title {
  color: #f7fbff;
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 22rpx rgba(34, 245, 255, 0.58), 6rpx 0 0 rgba(224, 68, 255, 0.36);
}

.hero-slogan {
  margin-top: 18rpx;
  color: #e6f4ff;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.section-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section-title text {
  color: #9da7c4;
  font-size: 22rpx;
  font-weight: 700;
}

.date-strip,
.filter-strip {
  width: 100%;
  white-space: nowrap;
}

.date-chip,
.filter-chip {
  display: inline-flex;
  margin-right: 14rpx;
  border: 1rpx solid rgba(149, 164, 207, 0.20);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(15, 23, 39, 0.96), rgba(8, 13, 24, 0.98));
  color: #e8ecff;
  font-weight: 900;
  box-sizing: border-box;
}

.date-chip {
  min-width: 108rpx;
  height: 92rpx;
  padding: 14rpx 14rpx 12rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  font-size: 25rpx;
}

.date-chip text {
  display: block;
  margin-top: 8rpx;
  color: #a2a8c4;
  font-size: 21rpx;
  font-weight: 700;
}

.filter-chip {
  min-width: 94rpx;
  height: 58rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  color: #d7dcf5;
  font-size: 24rpx;
}

.active-chip {
  border-color: rgba(34, 245, 255, 0.88);
  background:
    radial-gradient(circle at 82% 0%, rgba(224, 68, 255, 0.34), transparent 48%),
    linear-gradient(180deg, rgba(20, 67, 75, 0.96), rgba(10, 23, 34, 0.98));
  color: #ffffff;
  box-shadow: 0 0 26rpx rgba(34, 245, 255, 0.28), inset 0 0 28rpx rgba(224, 68, 255, 0.12);
}

.booking-card {
  padding: 20rpx;
  border: 1rpx solid rgba(73, 238, 255, 0.22);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(11, 23, 32, 0.94), rgba(6, 12, 22, 0.98));
  box-shadow: inset 0 0 42rpx rgba(34, 245, 255, 0.05);
}

.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(149, 164, 207, 0.13);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  margin-bottom: 14rpx;
}

.control-title {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
}

.panel-desc {
  max-width: 390rpx;
  margin-top: 8rpx;
  color: #a2a8c4;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.stepper-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn,
.step-value {
  height: 44rpx;
  border-radius: 12rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 900;
}

.step-btn {
  width: 48rpx;
  background: rgba(157, 167, 196, 0.16);
  color: #eef2ff;
}

.step-value {
  min-width: 76rpx;
  padding: 0 16rpx;
  background: rgba(34, 245, 255, 0.18);
  color: #22f5ff;
}

.time-panel {
  padding: 16rpx;
  border: 1rpx solid rgba(149, 164, 207, 0.13);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
}

.time-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.arrival-value {
  min-width: 126rpx;
  height: 58rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.52);
  border-radius: 16rpx;
  background: rgba(34, 245, 255, 0.10);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.time-wheel {
  width: 100%;
  height: 220rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(34, 245, 255, 0.18);
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.42);
}

.time-wheel-item {
  height: 74rpx;
  color: #edf2ff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 74rpx;
  text-align: center;
}

.time-wheel-indicator {
  height: 74rpx;
  border-top: 1rpx solid rgba(34, 245, 255, 0.44);
  border-bottom: 1rpx solid rgba(34, 245, 255, 0.44);
  background: rgba(34, 245, 255, 0.10);
}

.time-wheel-mask {
  background: linear-gradient(180deg, rgba(2, 5, 10, 0.94), rgba(2, 5, 10, 0), rgba(2, 5, 10, 0.94));
}

.time-wheel-labels {
  display: flex;
  margin-top: 8rpx;
  color: #8d96b8;
  font-size: 21rpx;
  font-weight: 700;
  text-align: center;
}

.time-wheel-labels view {
  flex: 1;
}

.table-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.table-card {
  position: relative;
  min-height: 246rpx;
  overflow: hidden;
  border: 1rpx solid rgba(149, 164, 207, 0.22);
  border-radius: 18rpx;
  background: #070b14;
  box-sizing: border-box;
}

.table-card.selected-card {
  border-color: rgba(34, 245, 255, 0.88);
  box-shadow: 0 0 30rpx rgba(34, 245, 255, 0.24), 0 0 28rpx rgba(224, 68, 255, 0.16);
}

.table-image {
  width: 100%;
  height: 120rpx;
  display: block;
}

.table-badge {
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd470, #9f6728);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.table-info {
  padding: 12rpx 14rpx 14rpx;
}

.table-code {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.table-type,
.table-meta {
  margin-top: 8rpx;
  color: #97a0bf;
  font-size: 20rpx;
  font-weight: 700;
}

.table-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}

.table-tags text {
  min-width: 0;
  padding: 4rpx 8rpx;
  border: 1rpx solid rgba(149, 164, 207, 0.12);
  border-radius: 999rpx;
  color: #aeb6d7;
  font-size: 17rpx;
  font-weight: 700;
}

.disabled-card {
  opacity: 0.48;
}

.assistant-strip scroll-view {
  width: 100%;
  white-space: nowrap;
}

.assistant-chip {
  display: inline-flex;
  align-items: center;
  min-width: 210rpx;
  height: 92rpx;
  margin-right: 14rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(149, 164, 207, 0.20);
  border-radius: 18rpx;
  background: rgba(9, 14, 27, 0.94);
  box-sizing: border-box;
}

.selected-assistant {
  border-color: rgba(224, 68, 255, 0.80);
  box-shadow: 0 0 24rpx rgba(224, 68, 255, 0.20);
}

.assistant-avatar {
  width: 62rpx;
  height: 62rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #04070e;
}

.assistant-name {
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
}

.assistant-price {
  margin-top: 6rpx;
  color: #ffd470;
  font-size: 19rpx;
  font-weight: 800;
}

.fixed-submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  padding: 14rpx;
  border: 1rpx solid rgba(34, 245, 255, 0.54);
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 92% 50%, rgba(224, 68, 255, 0.42), transparent 32%),
    linear-gradient(90deg, rgba(8, 36, 48, 0.96), rgba(26, 10, 38, 0.98));
  box-shadow: 0 0 44rpx rgba(34, 245, 255, 0.26), 0 0 36rpx rgba(224, 68, 255, 0.24);
}

.submit-meta {
  margin: 0 12rpx 10rpx;
  color: #aeb6d7;
  font-size: 19rpx;
  font-weight: 700;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  text-shadow: 0 0 18rpx rgba(255, 255, 255, 0.45);
}

.submit-button.disabled {
  opacity: 0.55;
}

.submit-arrow {
  width: 56rpx;
  height: 56rpx;
  margin-left: 28rpx;
  border: 2rpx solid rgba(224, 68, 255, 0.78);
  border-radius: 50%;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 0 24rpx rgba(224, 68, 255, 0.48);
}
