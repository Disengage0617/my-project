@import "../../app.wxss";

.reservation-tabs {
  width: 100%;
  margin: 0 0 20rpx;
  white-space: nowrap;
}

.reservation-tab {
  display: inline-flex;
  height: 64rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: #d8eee7;
  font-size: 26rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.05);
}

.active-tab {
  border-color: rgba(15, 199, 141, 0.48);
  background: rgba(15, 199, 141, 0.18);
  color: #f3fff8;
}

.reservation-actions {
  flex-shrink: 0;
}
