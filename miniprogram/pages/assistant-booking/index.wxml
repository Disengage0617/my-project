<view class="page">
  <view class="page-header">
    <view class="eyebrow">助理教练</view>
    <view class="title large">{{assistant.name || '助教服务'}}</view>
    <view class="subtitle">{{assistant.levelText || '选择时段后提交需求，员工确认后生效。'}}</view>
  </view>

  <view class="assistant-hero section">
    <image class="assistant-hero-photo" src="{{assistant.photoUrl || '/assets/generated/assistant-thumb.jpg'}}" mode="aspectFill" />
    <view class="assistant-hero-info">
      <view class="title">{{assistant.name || '助理教练'}}</view>
      <view class="subtitle">{{assistant.intro || '到店后由员工确认服务安排。'}}</view>
      <view class="tag gold">{{assistant.price || 88}} 元/小时</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="panel section">
    <view class="row start">
      <view>
        <view class="title">服务安排</view>
        <view class="subtitle">{{startTime}} 开始 · {{durationHours}} 小时</view>
      </view>
      <view class="tag">{{assistant.status || '待确认'}}</view>
    </view>
    <view class="divider"></view>
    <view class="row">
      <view>时长</view>
      <view class="row">
        <view class="tag muted" data-delta="-1" bindtap="changeDuration">-</view>
        <view class="tag">{{durationHours}}小时</view>
        <view class="tag muted" data-delta="1" bindtap="changeDuration">+</view>
      </view>
    </view>
  </view>

  <view class="panel section">
    <view class="title">确认规则</view>
    <view class="subtitle">一期不绑定支付。提交后进入待确认状态，员工会根据助教空闲情况安排。</view>
  </view>

  <view class="button secondary" bindtap="submit">{{submitting ? '提交中...' : '提交助教预约'}}</view>
</view>
