page {
  min-height: 100vh;
  background-color: #020807;
  color: #f3fff8;
}

.page {
  min-height: 100vh;
  padding: 18rpx 14rpx 240rpx;
  background:
    linear-gradient(180deg, rgba(8, 18, 15, 0.96) 0%, rgba(2, 8, 7, 1) 58%, rgba(2, 8, 7, 1) 100%);
  box-sizing: border-box;
}

.section {
  margin-bottom: 16rpx;
}

.cyber-cover {
  position: relative;
  height: 900rpx;
  overflow: hidden;
  border: 1rpx solid rgba(31, 241, 224, 0.44);
  border-radius: 10rpx;
  background-color: #030908;
  box-shadow: 0 0 0 1rpx rgba(115, 61, 255, 0.22), 0 26rpx 70rpx rgba(0, 0, 0, 0.56);
}

.cover-swiper,
.cover-bg,
.cover-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover-bg {
  display: block;
}

.cover-shade {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(1, 6, 8, 0.18) 0%, rgba(1, 6, 8, 0.14) 42%, rgba(1, 8, 7, 0.92) 100%),
    radial-gradient(circle at 12% 16%, rgba(20, 240, 255, 0.20), transparent 30%),
    radial-gradient(circle at 88% 14%, rgba(175, 58, 255, 0.20), transparent 32%);
}

.cover-top,
.cover-copy,
.cover-live-card,
.cover-event,
.cover-dots {
  position: relative;
  z-index: 2;
}

.cover-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 22rpx 0;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  width: 50rpx;
  height: 50rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(255, 218, 128, 0.92);
  color: #ffe6a8;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
  text-shadow: 0 0 20rpx rgba(255, 206, 105, 0.58);
  box-sizing: border-box;
}

.brand-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-sub {
  margin-top: 8rpx;
  color: #29f6c5;
  font-size: 14rpx;
  font-weight: 900;
  line-height: 1;
}

.store-pill {
  flex-shrink: 0;
  max-width: 292rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(31, 241, 224, 0.28);
  border-radius: 18rpx;
  background-color: rgba(2, 12, 12, 0.72);
  box-sizing: border-box;
}

.store-name {
  color: #f3fff8;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.18;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.store-status {
  margin-top: 8rpx;
  color: #69f8be;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cover-copy {
  width: 62%;
  padding: 90rpx 22rpx 0;
}

.neon-kicker {
  color: #31ffc9;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1;
}

.club-title {
  margin-top: 12rpx;
  color: #f4fff9;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.04;
  text-shadow: 0 0 30rpx rgba(47, 211, 255, 0.34);
}

.club-subtitle {
  margin-top: 12rpx;
  color: #c8fff2;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.cover-live-card {
  position: absolute;
  left: 22rpx;
  bottom: 24rpx;
  width: 330rpx;
  padding: 18rpx 18rpx 16rpx;
  border: 1rpx solid rgba(31, 241, 224, 0.34);
  border-radius: 18rpx;
  background-color: rgba(2, 12, 14, 0.78);
  box-shadow: inset 0 0 34rpx rgba(0, 232, 214, 0.10);
  box-sizing: border-box;
}

.live-card-title {
  color: #31ffc9;
  font-size: 24rpx;
  font-weight: 900;
}

.live-card-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
}

.live-label {
  color: #93afa8;
  font-size: 20rpx;
  font-weight: 700;
}

.live-number {
  margin-top: 8rpx;
  color: #f8fffb;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.live-number text {
  margin-left: 4rpx;
  color: #b8d3ca;
  font-size: 19rpx;
}

.live-card-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  color: #7bdcca;
  font-size: 18rpx;
  font-weight: 700;
}

.cover-event {
  position: absolute;
  right: 20rpx;
  bottom: 178rpx;
  width: 252rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 72, 105, 0.70);
  border-radius: 18rpx;
  background-color: rgba(34, 8, 18, 0.76);
  box-shadow: 0 0 34rpx rgba(255, 72, 105, 0.18);
  box-sizing: border-box;
}

.event-kicker {
  color: #ff637d;
  font-size: 20rpx;
  font-weight: 900;
}

.event-title {
  margin-top: 8rpx;
  color: #fff6f6;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.event-meta {
  margin-top: 8rpx;
  color: #ffc3cd;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cover-dots {
  position: absolute;
  right: 24rpx;
  bottom: 34rpx;
  display: flex;
  gap: 10rpx;
}

.cover-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.32);
}

.cover-dot.active {
  width: 36rpx;
  background-color: #31ffc9;
  box-shadow: 0 0 18rpx rgba(49, 255, 201, 0.66);
}

.zone-section {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(31, 241, 224, 0.42);
  border-radius: 14rpx;
  background-color: rgba(2, 13, 12, 0.94);
  box-shadow: 0 0 34rpx rgba(0, 240, 214, 0.10);
  box-sizing: border-box;
}

.zone-card {
  flex: 1;
  min-width: 0;
  min-height: 124rpx;
  padding: 12rpx 6rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: linear-gradient(180deg, rgba(15, 30, 27, 0.94), rgba(4, 13, 12, 0.96));
  text-align: center;
  box-sizing: border-box;
}

.zone-card.active {
  border-color: rgba(49, 255, 201, 0.74);
  background: linear-gradient(180deg, rgba(18, 62, 50, 0.94), rgba(5, 20, 17, 0.98));
  box-shadow: inset 0 0 28rpx rgba(49, 255, 201, 0.12);
}

.zone-letter {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.zone-cyan .zone-letter,
.zone-blue .zone-letter {
  color: #6ffaff;
}

.zone-green .zone-letter {
  color: #31ffc9;
}

.zone-gold .zone-letter {
  color: #ffd16b;
}

.zone-rose .zone-letter {
  color: #ffb56f;
}

.zone-name {
  margin-top: 8rpx;
  color: #eafff7;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.zone-range {
  margin-top: 4rpx;
  color: #85a29a;
  font-size: 15rpx;
  font-weight: 700;
  white-space: nowrap;
}

.zone-count {
  margin-top: 8rpx;
  color: #90aaa2;
  font-size: 20rpx;
  font-weight: 800;
}

.zone-count text {
  margin-right: 4rpx;
  color: #31ffc9;
  font-size: 36rpx;
  font-weight: 900;
}

.zone-gold .zone-count text,
.zone-rose .zone-count text {
  color: #ffd16b;
}

.reservation-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 150rpx;
  padding: 24rpx 24rpx 24rpx 30rpx;
  border: 1rpx solid rgba(49, 255, 201, 0.44);
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 88% 50%, rgba(151, 47, 255, 0.44), transparent 30%),
    linear-gradient(90deg, rgba(6, 46, 40, 0.96), rgba(12, 15, 31, 0.98));
  box-shadow: 0 0 42rpx rgba(49, 255, 201, 0.14), inset 0 0 44rpx rgba(49, 255, 201, 0.10);
  box-sizing: border-box;
}

.cta-kicker {
  color: #b8fff0;
  font-size: 20rpx;
  font-weight: 800;
}

.cta-title {
  margin-top: 10rpx;
  color: #dffff7;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
  text-shadow: 0 0 30rpx rgba(49, 255, 201, 0.45);
}

.cta-subtitle {
  margin-top: 10rpx;
  color: #9bb6ae;
  font-size: 22rpx;
  font-weight: 700;
}

.cta-orb {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(49, 255, 201, 0.54);
  border-radius: 50%;
  background:
    radial-gradient(circle at 42% 36%, #ffffff 0%, #ffffff 10%, #111 18%, #0f0f0f 52%, #000 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 110rpx;
  text-align: center;
  box-shadow: 0 0 34rpx rgba(49, 255, 201, 0.34);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.quick-card {
  min-height: 136rpx;
  padding: 16rpx 8rpx 14rpx;
  border: 1rpx solid rgba(49, 255, 201, 0.16);
  border-radius: 14rpx;
  background: linear-gradient(180deg, rgba(9, 26, 24, 0.96), rgba(5, 13, 13, 0.98));
  text-align: center;
  box-sizing: border-box;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto 10rpx;
  border: 1rpx solid rgba(49, 255, 201, 0.34);
  border-radius: 12rpx;
  color: #31ffc9;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-align: center;
  box-sizing: border-box;
}

.quick-title {
  color: #f3fff8;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.quick-subtitle {
  margin-top: 6rpx;
  color: #87a39b;
  font-size: 17rpx;
  font-weight: 700;
  white-space: nowrap;
}

.rule-strip {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  padding: 16rpx 14rpx;
  border: 1rpx solid rgba(49, 255, 201, 0.14);
  border-radius: 14rpx;
  background-color: rgba(4, 16, 15, 0.94);
  color: #79d8c5;
  font-size: 18rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.panel {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border: 1rpx solid rgba(49, 255, 201, 0.16);
  border-radius: 18rpx;
  background-color: rgba(9, 25, 23, 0.94);
  box-sizing: border-box;
}

.subtitle {
  color: #c6d8d1;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.46;
}

.status-danger {
  color: #ff637d;
}

.reservation-cta:active,
.quick-card:active,
.zone-card:active {
  transform: scale(0.98);
}
