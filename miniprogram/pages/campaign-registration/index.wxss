@import "../../app.wxss";

.form-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(47, 211, 255, 0.16);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 28rpx;
  color: #f3fff8;
  box-sizing: border-box;
}

.mini-button {
  flex: 0 0 auto;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(47, 211, 255, 0.12);
  color: #c6f7ff;
  font-size: 25rpx;
  font-weight: 850;
}

.mini-button::after {
  border: 0;
}
