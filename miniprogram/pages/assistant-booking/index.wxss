@import "../../app.wxss";

.assistant-hero {
  position: relative;
  min-height: 320rpx;
  overflow: hidden;
  border: 1rpx solid rgba(47, 211, 255, 0.22);
  border-radius: 22rpx;
  background: #07100e;
}

.assistant-hero-photo {
  width: 100%;
  height: 320rpx;
  display: block;
}

.assistant-hero-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 88rpx 24rpx 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(5, 11, 10, 0.94));
}

.assistant-hero-info .tag {
  margin-top: 16rpx;
}
