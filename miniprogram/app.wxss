page {
  min-height: 100vh;
  background: #03050b;
  color: #f3fff8;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 26rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(38, 245, 255, 0.18), transparent 34%),
    radial-gradient(circle at 86% 12%, rgba(211, 67, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #090b15 0%, #04070e 52%, #020409 100%);
}

.page.safe-bottom {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 14rpx 4rpx 30rpx;
}

.eyebrow {
  color: #2fd3ff;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-bottom: 10rpx;
}

.title {
  color: #f3fff8;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.24;
}

.title.large {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.12;
}

.subtitle {
  color: #c6d8d1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.55;
  margin-top: 8rpx;
}

.section {
  margin-bottom: 24rpx;
}

.panel,
.card {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(13, 20, 32, 0.96), rgba(5, 10, 18, 0.98));
  border: 1rpx solid rgba(94, 232, 255, 0.18);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 52rpx rgba(0, 0, 0, 0.48), inset 0 0 34rpx rgba(73, 218, 255, 0.04);
  box-sizing: border-box;
}

.panel::before,
.card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(37, 239, 255, 0.78), rgba(221, 84, 255, 0.62), transparent);
  opacity: 0.65;
}

.panel.flat {
  box-shadow: none;
  background: rgba(22, 35, 31, 0.76);
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 430rpx;
  background:
    radial-gradient(circle at 16% 14%, rgba(47, 211, 255, 0.24), transparent 30%),
    radial-gradient(circle at 78% 12%, rgba(15, 199, 141, 0.20), transparent 28%),
    linear-gradient(135deg, #101a18 0%, #142721 56%, #07100e 100%);
  border: 1rpx solid rgba(47, 211, 255, 0.18);
  border-radius: 24rpx;
  padding: 36rpx 30rpx 30rpx;
  color: #f3fff8;
  box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.42);
  box-sizing: border-box;
}

.hero::before {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 118rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(15, 199, 141, 0), rgba(47, 211, 255, 0.86), rgba(15, 199, 141, 0));
  box-shadow: 0 0 32rpx rgba(47, 211, 255, 0.36);
}

.hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -120rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(47, 211, 255, 0.22);
  background: rgba(47, 211, 255, 0.07);
}

.hero > view {
  position: relative;
  z-index: 1;
}

.hero .eyebrow {
  color: #d7b66d;
}

.hero .subtitle {
  color: #c6d8d1;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 30rpx;
  margin-bottom: 26rpx;
}

.metric-tile {
  min-height: 132rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(47, 211, 255, 0.16);
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.row.start {
  align-items: flex-start;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.metric {
  color: #0fc78d;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 28rpx rgba(15, 199, 141, 0.28);
}

.metric.light {
  color: #f3fff8;
  text-shadow: 0 0 30rpx rgba(47, 211, 255, 0.34);
}

.button {
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #0fc78d;
  color: #06100d;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 34rpx rgba(15, 199, 141, 0.22);
}

.button.secondary {
  background: #d7b66d;
  color: #070d0c;
  box-shadow: 0 16rpx 34rpx rgba(215, 182, 109, 0.18);
}

.button.ghost {
  background: rgba(47, 211, 255, 0.12);
  color: #c6f7ff;
  box-shadow: none;
}

.button.danger {
  background: #ff5f56;
  color: #ffffff;
}

.button:active,
.card:active,
.panel:active {
  transform: scale(0.98);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(85, 242, 255, 0.18);
  border-radius: 12rpx;
  background: rgba(37, 239, 255, 0.10);
  color: #22f5ff;
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
  box-sizing: border-box;
}

.tag.gold {
  border-color: rgba(255, 210, 112, 0.22);
  background: rgba(255, 210, 112, 0.16);
  color: #ffd470;
}

.tag.muted {
  border-color: rgba(174, 182, 215, 0.14);
  background: rgba(174, 182, 215, 0.10);
  color: #aeb6d7;
}

.tag.danger {
  background: rgba(255, 95, 86, 0.16);
  color: #ff5f56;
}

.tag.dark {
  background: rgba(47, 211, 255, 0.12);
  color: #c6f7ff;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 22rpx 0;
}

.status-free,
.status-success {
  color: #0fc78d;
}

.status-reserved {
  color: #2fd3ff;
}

.status-using {
  color: #ffb454;
}

.status-danger {
  color: #ff5f56;
}

.empty {
  padding: 42rpx 28rpx;
  text-align: center;
  color: #8ca39a;
}

.empty .title {
  margin-bottom: 8rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-heading .subtitle {
  margin-top: 4rpx;
}

.action-card {
  min-height: 188rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.action-card.primary {
  border-color: rgba(215, 182, 109, 0.24);
}

.list-item-title {
  color: #f3fff8;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
