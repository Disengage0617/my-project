<view class="page">
  <view class="page-header">
    <view class="eyebrow">活动报名</view>
    <view class="title large">确认参与信息</view>
    <view class="subtitle">报名信息用于门店联系和名额确认。</view>
  </view>

  <view wx:if="{{errorMessage}}" class="panel section">
    <view class="subtitle status-danger">{{errorMessage}}</view>
  </view>

  <view class="panel section">
    <view class="title">用户信息</view>
    <view class="divider"></view>
    <view class="row">
      <view>微信昵称</view>
      <view class="tag">{{profile.nickName}}</view>
    </view>
    <view class="divider"></view>
    <view class="row">
      <view>手机号</view>
      <view class="tag muted">{{phoneText}}</view>
    </view>
    <view class="divider"></view>
    <view class="form-row">
      <input class="input" type="number" maxlength="11" value="{{profile.phone}}" placeholder="填写测试手机号" placeholder-style="color:#8ca39a;" bindinput="inputPhone" />
      <button class="mini-button" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">授权手机号</button>
    </view>
    <view class="subtitle">{{phoneTip}}</view>
  </view>

  <view class="panel section">
    <view class="row">
      <view>
        <view class="title">参与人数</view>
        <view class="subtitle">默认本人报名，最多可代报 4 人。</view>
      </view>
      <view class="row">
        <view class="tag muted" data-delta="-1" bindtap="changeCount">-</view>
        <view class="tag">{{participantCount}}人</view>
        <view class="tag muted" data-delta="1" bindtap="changeCount">+</view>
      </view>
    </view>
  </view>

  <view class="panel section">
    <view class="title">报名规则</view>
    <view class="subtitle">限额活动可能进入待审核；门店确认后请按活动时间到店。</view>
  </view>

  <view class="button secondary" bindtap="submit">{{submitText}}</view>
</view>
