<view class="page">
  <view class="page-header">
    <view class="eyebrow">配置中心</view>
    <view class="title large">把门店基础资料补齐</view>
    <view class="subtitle">商家后台能力还需要后端配置接口支持，本页先固定信息架构。</view>
  </view>

  <view class="stack">
    <block wx:for="{{entries}}" wx:key="name">
      <view class="panel">
        <view class="row start">
          <view>
            <view class="title">{{item.name}}</view>
            <view class="subtitle">{{item.desc}}</view>
          </view>
          <view class="tag gold">{{item.status}}</view>
        </view>
      </view>
    </block>
  </view>
</view>
